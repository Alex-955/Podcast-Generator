# 拾声集（InkCast）· 双人对话播客生成器 环境变量模板
# 如需在服务端配置默认参数，可复制本文件为 .env 后按需填写；
# 留空时也可直接在网页右上角「模型与语音」中配置（密钥仅保存在浏览器本地存储）。

# 留空从 3456 到 3475 依次尝试，全被占用时使用系统随机空闲端口
# 显式指定的端口被占用时启动失败。PORT=0 直接使用系统随机空闲端口
# PORT=3456
# 局域网手机试听可设 HOST=0.0.0.0
HOST=127.0.0.1

# 局域网删除管理令牌；留空时仅允许本机（loopback）删除本地历史播客
ADMIN_TOKEN=

# 运行时数据与成品播客存放目录（支持相对路径或独立用户数据目录）
DATA_DIR=./data
PODCASTS_DIR=./public/podcasts

# 默认剧本生成大模型配置（OpenAI Chat Completions 兼容协议）
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# 默认长图识字视觉模型配置（留空时可由前端配置传入或复用主模型）
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=

# 默认语音合成服务商：edge | minimax | volcengine
TTS_PROVIDER=edge

# MiniMax Speech 配置
MINIMAX_API_KEY=
MINIMAX_TTS_MODEL=speech-02-hd
MINIMAX_TTS_ENDPOINT=https://api.minimaxi.com/v1/t2a_v2

# 火山引擎（豆包语音 V3）配置
VOLCENGINE_TTS_API_KEY=
VOLCENGINE_TTS_APP_ID=
VOLCENGINE_TTS_ACCESS_KEY=
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
VOLCENGINE_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional

# 网络与调试可选项（默认关闭，仅按需取消注释启用）
# ALLOW_PRIVATE_TTS_ENDPOINT=1
# ALLOW_INSECURE_TLS=1
# ALLOW_PRIVATE_FETCH=1
# CORS_ORIGIN=http://127.0.0.1:3456
